# Services
REST_PORT=8000
GRPC_PORT=50051
REQUESTS_TOPIC=wine-requests
PREDICTIONS_TOPIC=wine-predictions
CONSUMER_GROUP=wine-predictor

# Kafka: internal port for containers, same-host and other-host ports for clients outside Docker
KAFKA_PORT=9092
KAFKA_SAME_HOST_PORT=29092
KAFKA_OTHER_HOST_PORT=29093
# IP of this machine for clients on other hosts
KAFKA_HOST_IP=127.0.0.1

# ZooKeeper and Kafdrop
ZOOKEEPER_PORT=2181
ZOOKEEPER_HOST_PORT=22181
KAFDROP_PORT=9000
