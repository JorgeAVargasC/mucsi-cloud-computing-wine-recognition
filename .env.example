REST_HOST=0.0.0.0
REST_PORT=8000
GRPC_PORT=50051
# Inside the Docker network use kafka:9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
REQUESTS_TOPIC=wine-requests
PREDICTIONS_TOPIC=wine-predictions
CONSUMER_GROUP=wine-predictor
KAFKA_CONNECT_RETRIES=30
KAFKA_CONNECT_WAIT_SECONDS=2
REST_URL=http://localhost:8000
GRPC_TARGET=localhost:50051
# In Docker: /models/wine-model.joblib
MODEL_PATH=model/wine-model.joblib
