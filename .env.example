# Environment variables read by the services.
# Values shown are the defaults used when a variable is not defined.
# Docker's --env-file does not strip quotes or inline comments: keep KEY=value only.

# REST service (rest_service/app.py)
REST_HOST=0.0.0.0
REST_PORT=8000

# gRPC service (grpc_service/server.py)
GRPC_PORT=50051

# Kafka worker (kafka_service/worker.py)
# Inside the Docker network use KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
REQUESTS_TOPIC=wine-requests
PREDICTIONS_TOPIC=wine-predictions
CONSUMER_GROUP=wine-predictor

# Test clients (rest_service/client.py, grpc_service/client.py)
REST_URL=http://localhost:8000
GRPC_TARGET=localhost:50051

# Model file (model/predictor.py). In Docker it is mounted as a volume, e.g. MODEL_PATH=/models/wine-model.joblib
# Default: model/wine-model.joblib next to predictor.py
MODEL_PATH=model/wine-model.joblib
